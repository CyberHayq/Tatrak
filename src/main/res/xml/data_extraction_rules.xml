<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Tatrak: the database holds the OMEMO identity keys; it leaves the phone only through our
         own encrypted backup; local Keystore-bound files are not portable -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>